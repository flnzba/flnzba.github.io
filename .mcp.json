{
  "mcpServers": {
    "codegraph": {
      "command": ".harness/node_modules/.bin/codegraph",
      "args": [
        "serve",
        "--mcp",
        "--path",
        "."
      ]
    },
    "workos": {
      "type": "http",
      "url": "https://mcp.workos.com/mcp"
    },
    "playwright": {
      "command": ".harness/node_modules/.bin/playwright-mcp",
      "args": [
        "--browser",
        "chromium",
        "--headless",
        "--isolated"
      ]
    }
  }
}
