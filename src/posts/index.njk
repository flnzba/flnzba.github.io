---
layout: layouts/base.njk
title: Posts
permalink: /posts/
eleventyExcludeFromCollections: true
---
{% from "partials/page-header.njk" import pageHeader %}

{% call pageHeader("Archive", "Writing", "Notes from building enterprise data platforms — what worked, what did not, and the parts the vendor documentation leaves out.") %}
  <p class="u-meta">
    {{ collections.posts.length }} article{{ "s" if collections.posts.length != 1 }} · <a href="/feed.xml" class="u-link inline-block px-1 py-1">RSS</a>
  </p>
{% endcall %}

<section class="u-shell py-14">
  <ul class="border-t border-rule">
    {% for post in collections.posts %}
      {% include "partials/post-row.njk" %}
    {% endfor %}
  </ul>
</section>
