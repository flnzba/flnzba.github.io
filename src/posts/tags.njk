---
layout: layouts/base.njk
eleventyExcludeFromCollections: true
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag | slugify }}/
eleventyComputed:
  title: "Tag: {{ tag }}"
  description: "Technical articles by Florian Zeba tagged {{ tag }}."
  canonical_url: "https://www.fzeba.com/tags/{{ tag | slugify }}/"
---
{% from "partials/page-header.njk" import pageHeader %}
{% set tagged = collections.posts | byTag(tag) %}

{% call pageHeader("Tag", "<code>" + (tag | escape) + "</code>") %}
  <p class="u-meta mb-4">{{ tagged.length }} article{{ "s" if tagged.length != 1 }}</p>
  <a href="/posts/" class="u-link inline-block py-1 font-mono text-[0.76rem] uppercase tracking-[0.09em]">&larr; All posts</a>
{% endcall %}

<section class="u-shell py-14">
  <ul class="border-t border-rule">
    {% for post in tagged %}
      {% include "partials/post-row.njk" %}
    {% endfor %}
  </ul>
</section>
