---
import { getAllPosts, getUniqueTagsWithCount as getPostTagsWithCount } from "@/data/post";
import { getAllProjects, getUniqueTagsWithCount as getProjectTagsWithCount } from "@/data/project";
import { getAllInsights, getUniqueTagsWithCount as getInsightTagsWithCount } from "@/data/insight";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const allProjects = await getAllProjects();
const allInsights = await getAllInsights();

// Aggregate tags from all collections
const postTags = getPostTagsWithCount(allPosts);
const projectTags = getProjectTagsWithCount(allProjects);
const insightTags = getInsightTagsWithCount(allInsights);

// Merge tag counts from all sources
const tagMap = new Map<string, number>();
for (const [tag, count] of postTags) {
	tagMap.set(tag, (tagMap.get(tag) ?? 0) + count);
}
for (const [tag, count] of projectTags) {
	tagMap.set(tag, (tagMap.get(tag) ?? 0) + count);
}
for (const [tag, count] of insightTags) {
	tagMap.set(tag, (tagMap.get(tag) ?? 0) + count);
}
const allTags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);

const meta = {
	description: "A list of all the topics I've written about in my posts, projects, and insights",
	title: "All Tags",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">Tags</h1>
	<ul class="space-y-4">
		{
			allTags.map(([tag, val]) => (
				<li class="flex items-center gap-x-2">
					<a
						class="cactus-link inline-block"
						data-astro-prefetch
						href={`/tags/${tag}/`}
						title={`View posts with the tag: ${tag}`}
					>
						&#35;{tag}
					</a>
					<span class="inline-block">
						- {val} Post{val > 1 && "s"}
					</span>
				</li>
			))
		}
	</ul>
</PageLayout>
