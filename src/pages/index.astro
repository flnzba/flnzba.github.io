---
import LinkBadges from '@/components/LinkBadges.astro';
import PageLayout from '@/layouts/Base.astro';
import { Image } from 'astro:assets';
import devPicFZ from '@/assets/devPicFZ.webp';
import TechStack from '@/components/TechStack.astro';
import ExpertiseShowcase from '@/components/ExpertiseShowcase.astro';
import PostsSectionPreview from '@/components/PostsSectionPreview.astro';
---

<PageLayout meta={{ title: 'Home' }}>
	<section>
		<Image
			alt="Florian Zeba Profile Picture"
			class="mb-8 size-40 rounded-md object-cover"
			src={devPicFZ}
		/>
		<h1 class='title mb-4'>Hello!</h1>
		<p class='mb-4'>
			I'm a dedicated IT professional with a passion for data and backend
			systems. I implement software solutions and algorithms that are
			effective, sustainable, and easy to maintain.
		</p>

		<LinkBadges />
	</section>

	<ExpertiseShowcase />

	<TechStack />

	<PostsSectionPreview />

</PageLayout>
