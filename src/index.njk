---
layout: layouts/base.njk
title: Home
---
<section class="relative overflow-hidden bg-gradient-to-b from-white to-gray-50 py-16 dark:from-dark-bg dark:to-gray-950 sm:py-20 lg:py-24">
  <div class="mx-auto grid w-full max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,28rem)] lg:px-8">
    <div class="max-w-3xl">
      <p class="mb-5 w-fit rounded-full border border-deep-blue/20 bg-deep-blue/5 px-4 py-2 text-sm font-semibold text-deep-blue dark:border-accent-blue/25 dark:bg-accent-blue/10 dark:text-accent-blue">Data &amp; AI Architect</p>
      <h1 class="font-display text-4xl font-bold leading-tight text-gray-950 dark:text-white md:text-5xl lg:text-6xl">Hello, I'm <span class="gradient-text">Florian.</span></h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-400">I integrate software and AI applications in enterprise settings, build digital products, and write about innovations in tech.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/projects/" class="inline-flex items-center justify-center rounded-lg bg-deep-blue px-5 py-3 text-sm font-bold text-white transition hover:bg-deep-blue/90 dark:bg-accent-blue dark:hover:bg-accent-blue/90">View projects</a>
        <a href="/posts/" class="inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white px-5 py-3 text-sm font-bold text-gray-900 transition hover:border-deep-blue hover:text-deep-blue dark:border-gray-800 dark:bg-gray-900 dark:text-gray-100 dark:hover:border-accent-blue dark:hover:text-accent-blue">Read posts</a>
      </div>
    </div>

    <div class="mx-auto w-full max-w-xs rounded-2xl border border-gray-200 bg-white p-3 shadow-soft dark:border-gray-800 dark:bg-gray-900">
      <div class="overflow-hidden rounded-xl bg-gray-50 p-3 dark:bg-gray-950">
        <img src="/assets/profile.webp" alt="Florian Zeba" class="aspect-[4/5] w-full rounded-lg object-cover" width="440" height="560" />
      </div>
    </div>
  </div>
</section>

<section class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
  <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-deep-blue dark:text-accent-blue">Writing</p>
      <h2 class="mt-2 font-display text-3xl font-bold text-gray-950 dark:text-white">Recent posts</h2>
    </div>
    <a href="/posts/" class="w-fit rounded-lg border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 transition hover:border-deep-blue hover:text-deep-blue dark:border-gray-800 dark:text-gray-300 dark:hover:border-accent-blue dark:hover:text-accent-blue">All posts &rarr;</a>
  </div>

  <div class="grid gap-5 lg:grid-cols-2">
  {% set recent = collections.posts | head(8) %}
  {% for post in recent %}
    {% include "partials/post-card.njk" %}
  {% endfor %}
  </div>
</section>
