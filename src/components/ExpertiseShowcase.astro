---
const expertiseAreas = [
  { title: "Data Mastery", description: "Robust data pipelines and data warehouses." },
  { title: "Backend Solutions", description: "APIs, microservices, and scalable architectures." },
  { title: "AI Innovation", description: "Machine learning models and data intelligence." },
  { title: "Cloud Architecture", description: "Scalable solutions on AWS, Azure, and GCP." },
];
---
<section class="mt-12">
	<h2 class="title mb-4 text-xl">What I do</h2>
	<ul class="space-y-2">
		{expertiseAreas.map(area => (
			<li>
				<span class="font-semibold">{area.title}</span>
				<span class="text-gray-600 dark:text-gray-400"> — {area.description}</span>
			</li>
		))}
	</ul>
</section>