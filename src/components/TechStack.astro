---
import techStack from '../data/techStack.json';
---

<section class='mt-12'>
    <h2 class='title mb-4 text-xl'>Tech Stack</h2>
    <ul class='flex flex-wrap gap-x-4 gap-y-1'>
        {
            techStack.map((tech) => (
                <li class='text-gray-600 dark:text-gray-400'>
                    {tech.href && tech.href !== '#' ? (
                        <a
                            href={tech.href}
                            class='cactus-link'
                            rel='noreferrer'
                            target='_blank'
                        >
                            {tech.title}
                        </a>
                    ) : (
                        <span>{tech.title}</span>
                    )}
                </li>
            ))
        }
    </ul>
</section>
