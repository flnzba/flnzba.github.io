---
import miniProjects from '../data/miniProjects.json';
---

<section class='mt-12'>
    <h2 class='title mb-4 text-xl'>Mini Projects</h2>
    <ul class='space-y-3'>
        {
            miniProjects.map((project) => (
                <li>
                    <a
                        href={project.href}
                        class='cactus-link'
                        rel='noreferrer'
                        target='_blank'
                    >
                        {project.title}
                    </a>
                    <span class='text-gray-600 dark:text-gray-400'> — {project.desc}</span>
                </li>
            ))
        }
    </ul>
</section>
