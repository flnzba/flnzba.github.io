<!doctype html>
<html lang="{{ site.language }}" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml" />

    <!-- Pagefind UI (only on /search/) -->
    {% if page.url == "/search/" %}
      <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    {% endif %}
    <link rel="stylesheet" href="/css/site.css?v={{ build.timestamp }}" />

    <!-- OpenGraph -->
    <meta property="og:title" content="{{ title or site.title }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}/assets/social-card.png" />

    <script>
      // Avoid FOUC: apply stored theme before render
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme = (stored === "light" || stored === "dark")
            ? stored
            : (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="sticky top-0 z-50 border-b border-gray-200/80 bg-white/80 backdrop-blur-vercel transition-colors dark:border-gray-800 dark:bg-dark-bg/80">
      {% include "partials/header.njk" %}
    </header>

    <main id="main-content" data-pagefind-body class="min-h-[calc(100vh-14rem)]">
      {{ content | safe }}
    </main>

    <footer class="border-t border-gray-200 bg-gray-50/90 dark:border-gray-800 dark:bg-gray-950/90">
      {% include "partials/footer.njk" %}
    </footer>

    <script src="/js/theme.js" defer></script>

    {% if page.url == "/search/" %}
      <script src="/pagefind/pagefind-ui.js" defer></script>
      <script defer>
        window.addEventListener("DOMContentLoaded", function () {
          new PagefindUI({ element: "#search", showSubResults: true });
        });
      </script>
    {% endif %}
  </body>
</html>
