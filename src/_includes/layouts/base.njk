<!doctype html>
<html lang="{{ site.language }}" data-theme="dark">
  <head>
    {% set metaDescription = description or site.description %}
    {% set canonicalHref = page.url | pageCanonicalUrl(canonical_url) %}
    {% set socialImage = site.defaultImage | absoluteUrl(site.url) %}
    {% if cover and cover.src %}
      {% set socialImage = cover.src | pageAssetUrl(page.url) %}
    {% endif %}
    {% set keywords = tags | compactKeywords(site.keywords) %}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} - {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ metaDescription }}" />
    <meta name="author" content="{{ site.author.name }}" />
    <meta name="generator" content="Eleventy" />
    <meta name="robots" content="{{ robots or 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}" />
    {% if keywords and keywords.length %}
      <meta name="keywords" content="{{ keywords | join(', ') }}" />
    {% endif %}
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href="{{ canonicalHref }}" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ '/feed.xml' | absoluteUrl(site.url) }}" />
    <link rel="alternate" type="text/plain" title="{{ site.title }} LLM guide" href="{{ '/llms.txt' | absoluteUrl(site.url) }}" />
    <link rel="author" href="{{ site.url }}/humans.txt" />
    {% for profile in site.social %}
      <link rel="me" href="{{ profile.url }}" />
    {% endfor %}

    <!-- Pagefind UI (only on /search/) -->
    {% if page.url == "/search/" %}
      <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    {% endif %}
    <link rel="stylesheet" href="/css/site.css?v={{ build.timestamp }}" />

    <!-- OpenGraph -->
    <meta property="og:title" content="{% if title %}{{ title }} - {{ site.title }}{% else %}{{ site.title }}{% endif %}" />
    <meta property="og:description" content="{{ metaDescription }}" />
    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:url" content="{{ canonicalHref }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:locale" content="{{ site.locale }}" />
    <meta property="og:image" content="{{ socialImage }}" />
    <meta property="og:image:secure_url" content="{{ socialImage }}" />
    <meta property="og:image:alt" content="{% if cover and cover.alt %}{{ cover.alt }}{% else %}{{ site.defaultImageAlt }}{% endif %}" />
    {% if contentType == "post" or contentType == "project" or ogType == "article" %}
      {% if date %}<meta property="article:published_time" content="{{ date | rfc3339 }}" />{% endif %}
      {% if updated or date %}<meta property="article:modified_time" content="{{ (updated or date) | rfc3339 }}" />{% endif %}
      <meta property="article:author" content="{{ site.author.name }}" />
      {% if tags and tags.length %}
        {% for tag in tags %}
          <meta property="article:tag" content="{{ tag }}" />
        {% endfor %}
      {% endif %}
    {% endif %}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{% if title %}{{ title }} - {{ site.title }}{% else %}{{ site.title }}{% endif %}" />
    <meta name="twitter:description" content="{{ metaDescription }}" />
    <meta name="twitter:image" content="{{ socialImage }}" />
    <meta name="twitter:image:alt" content="{% if cover and cover.alt %}{{ cover.alt }}{% else %}{{ site.defaultImageAlt }}{% endif %}" />

    {% seoJsonLd page, site, title, metaDescription, contentType, ogType, date, updated, tags, cover, canonical_url %}

    <script>
      // Avoid FOUC: apply stored theme before render
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme = (stored === "light" || stored === "dark")
            ? stored
            : (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="sticky top-0 z-50 border-b border-gray-200/80 bg-white/80 backdrop-blur-vercel transition-colors dark:border-gray-800 dark:bg-dark-bg/80">
      {% include "partials/header.njk" %}
    </header>

    <main id="main-content" data-pagefind-body class="min-h-[calc(100vh-14rem)]">
      {{ content | safe }}
    </main>

    <footer class="border-t border-gray-200 bg-gray-50/90 dark:border-gray-800 dark:bg-gray-950/90">
      {% include "partials/footer.njk" %}
    </footer>

    <script src="/js/theme.js" defer></script>

    {% if page.url == "/search/" %}
      <script src="/pagefind/pagefind-ui.js" defer></script>
      <script defer>
        window.addEventListener("DOMContentLoaded", function () {
          new PagefindUI({ element: "#search", showSubResults: true });
        });
      </script>
    {% endif %}
  </body>
</html>
