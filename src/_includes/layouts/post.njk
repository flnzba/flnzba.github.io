---
layout: layouts/base.njk
contentType: post
ogType: article
---
<article class="pb-16">
  <header class="border-b border-rule py-14 sm:py-16">
    <div class="u-shell max-w-3xl">
      <p class="u-meta">
        <time datetime="{{ date | htmlDateString }}">{{ date | htmlDateString }}</time>
        {%- if readingTime %} · {{ readingTime }} min{% endif -%}
        {%- if updated and (updated | htmlDateString) != (date | htmlDateString) %} · updated {{ updated | htmlDateString }}{% endif -%}
      </p>
      <h1 class="u-display mt-4 text-[clamp(1.9rem,4.5vw,3.1rem)]">{{ title }}</h1>
      {% if description %}
        <p class="mt-5 max-w-2xl text-[1.05rem] leading-relaxed text-ink-2">{{ description }}</p>
      {% endif %}
      {% if tags and tags.length %}
        {# Taller and further apart than the decorative chips elsewhere: these
           are links, and at py-px they were a 21px tap target 6px from the
           next one. #}
        <div class="mt-6 flex flex-wrap gap-2">
          {% for t in tags %}
            <a href="/tags/{{ t | slugify }}/" class="border border-rule px-2 py-1 font-mono text-[0.66rem] text-ink-3 transition-colors hover:border-ink hover:text-ink">{{ t }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </header>

  {% if cover and cover.src %}
    <div class="u-shell max-w-3xl pt-10">
      <img src="{{ cover.src | replace('./', page.url) }}" alt="{{ cover.alt }}" class="cover aspect-video w-full border border-rule object-cover" />
    </div>
  {% endif %}

  <div class="u-shell">
    <div class="article-body mt-10 max-w-3xl">
      {{ content | safe }}
    </div>
  </div>

  <footer class="u-shell mt-14 max-w-3xl">
    <div class="border-t border-rule pt-8">
      <a href="/posts/" class="u-link inline-block py-1 font-mono text-[0.76rem] uppercase tracking-[0.09em]">&larr; All posts</a>
    </div>
  </footer>
</article>
