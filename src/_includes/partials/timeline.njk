{#
  Roles-held-to-scale figure. Pure CSS + Nunjucks, no JavaScript.

  Caller may set `timelineNote` for the caption aside. Data comes from cv.roles;
  bar geometry from the timelineSpan / timelineTicks filters in .eleventy.js.

  Below `sm` the bars are too narrow to read, so the component swaps to a
  stacked text list. Both variants render from the same loop; only one shows.
#}
{% set barColour = { industry: "bg-ink", founded: "bg-ultra", advisory: "bg-ink-3" } %}
{% set typeLabel = { industry: "Employment", founded: "Founded & led", advisory: "Advisory" } %}
{% set ticks = "" | timelineTicks %}

<figure class="u-reveal">
  <figcaption class="mb-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <span class="u-eyebrow">Fig. 1 — Roles held, to scale</span>
    {% if timelineNote %}<span class="text-[0.78rem] text-ink-3">{{ timelineNote }}</span>{% endif %}
  </figcaption>

  {# ---- Chart, sm and up ---- #}
  <div class="hidden sm:block">
    {# The axis labels are decorative: the sr-only list below carries the same
       dates as text, so announcing "2018 2020 2022…" first is just noise. #}
    <div class="grid grid-cols-[13rem_minmax(0,1fr)] gap-x-4" aria-hidden="true">
      <span></span>
      <div class="relative h-5 border-b border-rule">
        {% for t in ticks %}
          <span class="absolute top-0 h-full border-l border-rule" style="left: {{ t.left }}%"></span>
          <span class="u-meta absolute top-0 pl-1.5 text-[0.68rem]" style="left: {{ t.left }}%">{{ t.year }}</span>
        {% endfor %}
      </div>
    </div>

    <ul class="divide-y divide-rule border-b border-rule" role="img" aria-label="Timeline of roles held from {{ ticks[0].year }} to the present. A text version follows.">
      {% for r in cv.roles %}
        <li class="grid grid-cols-[13rem_minmax(0,1fr)] items-center gap-x-4 py-2">
          <span class="u-meta truncate" title="{{ r.org }} — {{ r.role }}">{{ r.shortOrg }}</span>
          <span class="relative block h-[9px]">
            {% for t in ticks %}
              <span class="absolute top-0 h-full border-l border-rule" style="left: {{ t.left }}%"></span>
            {% endfor %}
            <span
              class="absolute top-0 h-full {{ barColour[r.type] }}{% if not r.end %} [mask-image:linear-gradient(to_right,#000_78%,transparent)]{% endif %}"
              style="left: {{ r | timelineSpan('left') }}%; width: {{ r | timelineSpan('width') }}%"
              title="{{ r.role }} · {{ r | dateRange }}"
            ></span>
          </span>
        </li>
      {% endfor %}
    </ul>

    {# Legend only the types that actually have a bar. A swatch with nothing
       to point at reads as data that failed to load. `push` mutates the array
       in place, so the side effect survives the loop's own scope. #}
    {% set usedTypes = [] %}
    {% for r in cv.roles %}
      {% if r.type not in usedTypes %}{% set _ = usedTypes.push(r.type) %}{% endif %}
    {% endfor %}
    <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
      {% for key, label in typeLabel %}
        {% if key in usedTypes %}
          <li class="flex items-center gap-2">
            <span class="block h-[9px] w-[9px] {{ barColour[key] }}"></span>
            <span class="u-meta text-[0.68rem]">{{ label }}</span>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  {# ---- Text list, below sm, and the accessible equivalent everywhere ---- #}
  <ul class="divide-y divide-rule border-y border-rule sm:sr-only">
    {% for r in cv.roles %}
      <li class="py-3">
        <p class="text-[0.95rem] text-ink">{{ r.org }}</p>
        <p class="text-[0.88rem] text-ink-2">{{ r.role }}</p>
        <p class="u-meta mt-0.5">{{ r | dateRange }} · {{ typeLabel[r.type] }}</p>
      </li>
    {% endfor %}
  </ul>
</figure>
