{#
  Roles-held-to-scale figure. Pure CSS + Nunjucks, no JavaScript.

  The axis is deliberately undated: bar lengths and overlaps are true to each
  other, but nothing on the page anchors them to a calendar. Geometry
  (`left` / `width`) is precomputed in src/_data/cv.js — see the note there
  before adding a role.

  Callers may set:
    timelineNote      caption aside, right of the figure number
    timelineHideList  true when the page already renders its own roles list
                      directly below. The chart cannot carry the figure alone —
                      it is hidden below `sm`, where the bars are too narrow to
                      read — so suppressing the built-in list also hides the
                      whole figure at that width, leaving the caller's list to
                      do the job. Without this the two lists stack up as
                      duplicated content, twice over for a screen reader.
#}
{% set barColour = { industry: "bg-ink", founded: "bg-ultra" } %}
{% set typeLabel = { industry: "Employment", founded: "Founded & led" } %}

<figure class="u-reveal{% if timelineHideList %} hidden sm:block{% endif %}">
  <figcaption class="mb-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <span class="u-eyebrow">Fig. 1 — Roles held, to scale</span>
    {% if timelineNote %}<span class="text-[0.78rem] text-ink-3">{{ timelineNote }}</span>{% endif %}
  </figcaption>

  {# ---- Chart, sm and up ---- #}
  <div class="hidden sm:block">
    <ul class="divide-y divide-rule border-y border-rule" role="img" aria-label="Roles held, drawn to relative scale on an undated axis. A text version follows.">
      {% for r in cv.roles %}
        <li class="grid grid-cols-[14rem_minmax(0,1fr)] items-center gap-x-4 py-2.5">
          <span class="min-w-0">
            <span class="block truncate text-[0.85rem] text-ink" title="{{ r.role }}">{{ r.short }}</span>
            <span class="u-meta block truncate text-[0.68rem]">{{ r.sector }}</span>
          </span>
          <span class="relative block h-[9px]">
            <span
              class="absolute top-0 h-full {{ barColour[r.type] }}{% if r.to === null %} [mask-image:linear-gradient(to_right,#000_72%,transparent)]{% endif %}"
              style="left: {{ r.left }}%; width: {{ r.width }}%"
              title="{{ r.role }}"
            ></span>
          </span>
        </li>
      {% endfor %}
    </ul>

    {# The axis carries direction but no scale — that is the whole point of the
       figure, so it is stated rather than left to be inferred from a blank. #}
    <div class="mt-2 grid grid-cols-[14rem_minmax(0,1fr)] gap-x-4" aria-hidden="true">
      <span></span>
      <span class="u-meta flex items-baseline justify-between text-[0.66rem]">
        <span>earlier</span>
        <span>now →</span>
      </span>
    </div>

    {# Legend only the types that actually have a bar. A swatch with nothing
       to point at reads as data that failed to load. `push` mutates the array
       in place, so the side effect survives the loop's own scope. #}
    {% set usedTypes = [] %}
    {% for r in cv.roles %}
      {% if r.type not in usedTypes %}{% set _ = usedTypes.push(r.type) %}{% endif %}
    {% endfor %}
    <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
      {% for key, label in typeLabel %}
        {% if key in usedTypes %}
          <li class="flex items-center gap-2">
            <span class="block h-[9px] w-[9px] {{ barColour[key] }}"></span>
            <span class="u-meta text-[0.68rem]">{{ label }}</span>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  {# ---- Text list, below sm, and the accessible equivalent everywhere ---- #}
  {% if not timelineHideList %}
    <ul class="divide-y divide-rule border-y border-rule sm:sr-only">
      {% for r in cv.roles %}
        <li class="py-3">
          <p class="text-[0.95rem] text-ink">{{ r.role }}</p>
          <p class="u-meta mt-0.5">{{ r.sector }} · {{ typeLabel[r.type] }}</p>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</figure>
