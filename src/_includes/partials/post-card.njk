<article class="group rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-deep-blue hover:shadow-soft dark:border-gray-800 dark:bg-gray-900 dark:hover:border-accent-blue">
  <header class="space-y-3">
    <div class="flex flex-wrap items-center gap-2 text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">
      <time datetime="{{ post.data.date | htmlDateString }}">{{ post.data.date | readableDate }}</time>
      {% if post.data.tags and post.data.tags.length %}
        <span aria-hidden="true">/</span>
        <span class="flex flex-wrap gap-2 normal-case tracking-normal">
          {% for t in post.data.tags %}
            <a href="/tags/{{ t | slugify }}/" class="tag text-xs text-gray-500 transition-colors hover:text-deep-blue dark:text-gray-400 dark:hover:text-accent-blue">{{ t }}</a>
          {% endfor %}
        </span>
      {% endif %}
    </div>
    <h2 class="font-display text-xl font-bold leading-tight text-gray-950 dark:text-white">
      <a href="{{ post.url }}" class="transition-colors group-hover:text-deep-blue dark:group-hover:text-accent-blue">{{ post.data.title }}</a>
    </h2>
  </header>
  {% if post.data.description %}
    <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-400">{{ post.data.description }}</p>
  {% endif %}
</article>
