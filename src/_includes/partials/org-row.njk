{# Expects `o` from src/_data/orgs.js. #}
<li class="border border-rule">
  <div class="grid gap-x-8 gap-y-3 p-6 sm:p-7 lg:grid-cols-[16rem_minmax(0,1fr)]">
    <div>
      <h3 class="u-display text-[1.15rem] text-ink">{{ o.name }}</h3>
      <p class="u-meta mt-1">{{ o.period }}</p>
      <p class="mt-2">
        <span class="border border-rule px-1.5 py-px font-mono text-[0.62rem] uppercase tracking-[0.1em] text-ink-3">{{ o.relationship }}</span>
      </p>
    </div>
    <div>
      <p class="text-[0.9rem] text-ink">{{ o.summary }}</p>
      <p class="mt-2 max-w-2xl text-[0.95rem] leading-relaxed text-ink-2">{{ o.body }}</p>
      {% if o.url %}
        <a href="{{ o.url }}" rel="noopener" class="u-link mt-3 inline-block font-mono text-[0.74rem]">{{ o.url | replace("https://", "") | replace("www.", "") | replace("/", "") }} ↗</a>
      {% endif %}
    </div>
  </div>
</li>
