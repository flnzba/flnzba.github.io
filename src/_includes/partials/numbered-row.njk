{#
  Numbered project row. Expects `project` (an Eleventy collection item) and
  `rowIndex` (1-based) in scope from the caller's loop.
#}
<li class="group border border-rule transition-colors hover:border-ink/25">
  <a href="{{ project.url }}" class="block p-6 sm:p-7">
    <p class="u-eyebrow">{{ "0" if rowIndex < 10 }}{{ rowIndex }}</p>
    <div class="mt-2 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h3 class="u-display text-[1.5rem] text-ink transition-colors group-hover:text-ultra">{{ project.data.title }}</h3>
      <span class="u-meta text-[0.7rem]">{{ project.date | readableDate }}</span>
    </div>
    {% if project.data.description %}
      <p class="mt-2 max-w-2xl text-[0.95rem] leading-relaxed text-ink-2">{{ project.data.description }}</p>
    {% endif %}
    {% if project.data.tags %}
      <div class="mt-4 flex flex-wrap gap-1.5">
        {% for t in project.data.tags %}
          <span class="border border-rule px-2 py-px font-mono text-[0.66rem] text-ink-3">{{ t }}</span>
        {% endfor %}
      </div>
    {% endif %}
  </a>
</li>
