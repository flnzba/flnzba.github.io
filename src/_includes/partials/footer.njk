<div class="u-shell grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
  <div class="lg:col-span-2">
    <p class="u-display text-[1.35rem]">{{ site.title }}</p>
    <p class="mt-1.5 max-w-sm text-[0.85rem] leading-relaxed text-ink-2">{{ site.description }}</p>
    <a href="mailto:{{ site.author.email }}" class="u-link mt-3 inline-block font-mono text-[0.78rem]">{{ site.author.email }}</a>
  </div>

  <nav aria-label="Site">
    <p class="u-eyebrow mb-2.5">Site</p>
    <ul class="space-y-1.5">
      {% for item in site.nav %}
        {% if item.url != "/" %}
          <li><a href="{{ item.url }}" class="text-[0.85rem] text-ink-2 transition-colors hover:text-ink">{{ item.text }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </nav>

  <nav aria-label="Elsewhere">
    <p class="u-eyebrow mb-2.5">Elsewhere</p>
    <ul class="space-y-1.5">
      {% for s in site.social %}
        <li><a href="{{ s.url }}" rel="me" class="text-[0.85rem] text-ink-2 transition-colors hover:text-ink">{{ s.name }}</a></li>
      {% endfor %}
      <li><a href="/feed.xml" class="text-[0.85rem] text-ink-2 transition-colors hover:text-ink">RSS</a></li>
    </ul>
  </nav>
</div>

<div class="u-shell border-t border-rule py-6">
  <p class="u-meta">© {{ build.year }} {{ site.author.name }} — {{ cv.location }}</p>
</div>
