<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-ink focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:uppercase focus:tracking-[0.09em] focus:text-surface">Skip to content</a>
<nav class="u-shell flex flex-wrap items-center justify-between gap-3 py-4 md:flex-nowrap md:gap-6" aria-label="Primary navigation">
  <a href="/" class="group flex w-fit items-center gap-2.5 text-ink transition-colors hover:text-ultra" aria-label="{{ site.title }} home">
    <span class="flex h-8 w-8 items-center justify-center border border-rule bg-surface">
      <img src="/assets/logo.png" alt="" class="h-5 w-auto opacity-85" />
    </span>
    <span class="u-display text-[1.05rem]">{{ site.title }}<span class="text-ultra">.</span></span>
  </a>

  <div class="flex items-center gap-2 md:order-3">
    {% include "partials/theme-toggle.njk" %}
    <button
      id="mobile-nav-toggle"
      type="button"
      class="inline-flex h-9 w-9 items-center justify-center border border-rule bg-surface text-ink-2 transition-colors hover:border-ink hover:text-ink md:hidden"
      aria-controls="primary-menu"
      aria-expanded="false"
      aria-label="Open navigation menu"
      title="Open navigation menu"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 7h16" />
        <path d="M4 12h16" />
        <path d="M4 17h16" />
      </svg>
    </button>
  </div>

  <div id="primary-menu" class="order-3 hidden w-full flex-col gap-1 border-t border-rule pt-3 md:order-2 md:flex md:w-auto md:flex-row md:items-center md:gap-x-5 md:border-0 md:pt-0">
    {% for item in site.nav %}
      {% if item.url != "/" %}
        {% set isActive = page.url and page.url.startsWith(item.url) %}
        <a
          href="{{ item.url }}"
          class="py-1.5 font-mono text-[0.76rem] uppercase tracking-[0.09em] transition-colors {% if isActive %}text-ink{% else %}text-ink-3 hover:text-ink{% endif %}"
          {% if isActive %}aria-current="page"{% endif %}
        >{{ item.text }}</a>
      {% endif %}
    {% endfor %}
  </div>
</nav>
