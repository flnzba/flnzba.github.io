<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-deep-blue focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Skip to content</a>
<nav class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-4 py-4 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8" aria-label="Primary navigation">
  <a href="/" class="flex w-fit items-center gap-3 text-gray-950 transition-colors hover:text-deep-blue dark:text-white dark:hover:text-accent-blue" aria-label="{{ site.title }} home">
    <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
      <img src="/assets/logo.png" alt="" class="h-6 w-auto opacity-85" />
    </span>
    <span class="font-display text-base font-bold tracking-normal">{{ site.title }}</span>
  </a>

  <div class="flex flex-wrap items-center gap-2 sm:gap-3">
    {% for item in site.nav %}
      {% if item.url != "/" %}
        {% set isActive = page.url and page.url.startsWith(item.url) %}
        <a
          href="{{ item.url }}"
          class="rounded-full px-3 py-2 text-sm font-medium transition-colors {% if isActive %}bg-deep-blue/10 text-deep-blue dark:bg-accent-blue/10 dark:text-accent-blue{% else %}text-gray-600 hover:bg-gray-100 hover:text-deep-blue dark:text-gray-400 dark:hover:bg-gray-900 dark:hover:text-accent-blue{% endif %}"
          {% if isActive %}aria-current="page"{% endif %}
        >{{ item.text }}</a>
      {% endif %}
    {% endfor %}
    {% include "partials/theme-toggle.njk" %}
  </div>
</nav>
