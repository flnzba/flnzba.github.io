{# Expects `p` from src/_data/research.js `papers`. #}
<li class="border border-rule p-6 sm:p-7">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <span class="border border-rule px-1.5 py-px font-mono text-[0.62rem] uppercase tracking-[0.1em] text-ink-3">{{ p.status }}</span>
    <span class="u-meta">{{ p.year }}{% if p.pages %} · {{ p.pages }} pp{% endif %}</span>
  </div>

  <h3 class="u-display mt-3 text-[1.35rem] text-ink">{{ p.title }}</h3>

  <p class="mt-2 text-[0.85rem] text-ink-2">
    {%- for a in p.authors -%}
      {%- if a == p.me %}<strong class="font-medium text-ink">{{ a }}</strong>{% else %}{{ a }}{% endif -%}
      {%- if not loop.last %}, {% endif -%}
    {%- endfor -%}
    {%- if p.affiliation %} — {{ p.affiliation }}{% endif -%}
  </p>

  {% if p.summary %}
    <div class="mt-5 border-t border-rule pt-4">
      <p class="u-eyebrow">Summary</p>
      <p class="mt-2 max-w-2xl text-[0.95rem] leading-relaxed text-ink-2">{{ p.summary }}</p>
    </div>
  {% endif %}

  {% if p.metrics %}
    <div class="mt-5 flex flex-wrap gap-x-10 gap-y-4">
      {% for m in p.metrics %}{% include "partials/metric.njk" %}{% endfor %}
    </div>
  {% endif %}

  {% if p.abstract %}
    <details class="mt-5 border-t border-rule pt-4">
      <summary class="u-link cursor-pointer py-1 font-mono text-[0.74rem] uppercase tracking-[0.09em]">Read the abstract</summary>
      <p class="mt-3 max-w-2xl text-[0.92rem] leading-relaxed text-ink-2">{{ p.abstract }}</p>
    </details>
  {% endif %}

  {# ------------------------------------------------------------ Citation -- #}
  {# Renders only for a paper that carries a `citation` block; both strings are
     derived from the fields above by filters in .eleventy.js, so they cannot
     drift from the card. The copy buttons start `hidden` and are revealed by
     theme.js — without JS there is no dead control, just selectable text. #}
  {% if p.citation %}
    {% set bib = p | bibtex %}
    {% set plain = p | plainCitation %}
    <details class="mt-5 border-t border-rule pt-4">
      <summary class="u-link cursor-pointer py-1 font-mono text-[0.74rem] uppercase tracking-[0.09em]">Cite this paper</summary>

      <div class="mt-4">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <p class="u-eyebrow">BibTeX</p>
          <button type="button" hidden data-copy="#bibtex-{{ p.citation.citeId }}" class="border border-rule px-2 py-1 font-mono text-[0.66rem] uppercase tracking-[0.09em] text-ink-3 transition-colors hover:border-ink hover:text-ink">Copy</button>
        </div>
        <pre id="bibtex-{{ p.citation.citeId }}" class="mt-2 overflow-x-auto border border-rule bg-surface-2/40 p-4 font-mono text-[0.74rem] leading-relaxed text-ink-2"><code>{{ bib }}</code></pre>
      </div>

      <div class="mt-5">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <p class="u-eyebrow">Plain text</p>
          <button type="button" hidden data-copy="#plain-{{ p.citation.citeId }}" class="border border-rule px-2 py-1 font-mono text-[0.66rem] uppercase tracking-[0.09em] text-ink-3 transition-colors hover:border-ink hover:text-ink">Copy</button>
        </div>
        <p id="plain-{{ p.citation.citeId }}" class="mt-2 max-w-2xl text-[0.9rem] leading-relaxed text-ink-2">{{ plain }}</p>
      </div>
    </details>
  {% endif %}

  {% if p.links %}
    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
      {% for l in p.links %}
        <a href="{{ l.href }}"{% if l.external %} rel="noopener"{% endif %} class="u-link inline-block py-1 font-mono text-[0.74rem]">{{ l.label }}{% if l.external %} ↗{% endif %}</a>
      {% endfor %}
    </div>
  {% endif %}

  {% if p.tags %}
    <div class="mt-4 flex flex-wrap gap-1.5">
      {% for t in p.tags %}
        <span class="border border-rule px-2 py-px font-mono text-[0.66rem] text-ink-3">{{ t }}</span>
      {% endfor %}
    </div>
  {% endif %}
</li>
