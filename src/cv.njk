---
# /cv/ merged into /about/ — the CV page and the profile page said the same
# thing once employers, dates and per-role task lists came off the site. This
# stub keeps inbound and printed links alive. GitHub Pages has no server-side
# redirects, hence the client-side hop.
permalink: /cv/index.html
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="{{ site.language }}" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Redirecting…</title>
    <link rel="canonical" href="{{ site.url }}/about/" />
    <meta http-equiv="refresh" content="0; url=/about/" />
    <script>
      location.replace("/about/" + location.search + location.hash);
    </script>
  </head>
  <body>
    <p>This page has moved to <a href="/about/">/about/</a>.</p>
  </body>
</html>
