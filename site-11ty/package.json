{
  "name": "flnzba-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Florian Zeba's personal site — 11ty + Pico CSS",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve --quiet",
    "clean": "rm -rf _site",
    "search": "pagefind --site _site",
    "migrate": "node scripts/migrate-frontmatter.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-rss": "^2.0.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "pagefind": "^1.1.1",
    "slugify": "^1.6.6"
  }
}
