# Cross-posting API credentials for Crier.
# Copy this file to `.env` and fill in real values, then run `npm run secrets:push`
# to upload them to the GitHub repo as Actions secrets.
#
# .env is gitignored — never commit real keys.

# DEV.to (https://dev.to/settings/extensions → "DEV API Keys")
DEVTO_API_KEY=

# Hashnode (https://hashnode.com/settings/developer)
# Format: <personal_access_token>:<publication_id>
HASHNODE_API_KEY=

# Medium (https://medium.com/me/settings/security → "Integration tokens")
# Note: Medium API is publish-only; existing stories cannot be updated.
MEDIUM_INTEGRATION_TOKEN=
